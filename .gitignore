# ==============================
# Terraform - Boas Práticas
# ==============================

# Estados do Terraform (CRÍTICO - nunca versionar)
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.*.backup

# Arquivos de plano
*.tfplan
*.tfplan.*

# Diretório de cache e plugins (cada ambiente tem o seu)
.terraform/
.terraform.lock.hcl  # VERSÃO: Comentar se quiser lock fixo por ambiente

# Estados remotos (se usar backend remoto)
# terraform.tfstate.d/  # descomente se usar state local

# ==============================
# Credentials e Secrets
# ==============================

# Chaves e certificados
*.pem
*.key
*.crt
*.cer
*.p12

# Arquivos com credenciais
*.csv
*.json (não sendo usado para secrets)
credenciais*
*credentials*
*secret*
*password*

# Variáveis sensíveis (TFVARS com valores reais)
*.tfvars

# AWS CLI
.aws/
aws_credentials*

# ==============================
# IDEs e Editores
# ==============================

.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ==============================
# Logs e Temporários
# ==============================

*.log
*.tmp
*.temp

# ==============================
# Observação para times
# ==============================
# Para configurar variáveis por ambiente:
# 1. Copie terraform.tfvars.example para terraform.tfvars
# 2. Preencha com os valores do seu ambiente
# 3. Não commite o terraform.tfvars com valores reais